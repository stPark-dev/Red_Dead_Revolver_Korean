{
 "_doc": "Terminology/voice decisions (translation-artifacts §1.1). state: proposed | approved | unresolved | conflicting. Only approved entries bind translators.",
 "policies": [
  {
   "id": "P-NAMES",
   "state": "approved",
   "rule": "Character/place proper names are transliterated by standard Korean loanword orthography (외래어 표기법).",
   "examples": {
    "Red Harlow": "레드 할로",
    "Bear Mountain": "베어 마운틴",
    "Brimstone": "브림스톤"
   },
   "approved": "2026-11-03 user (AskUserQuestion: nicknames by meaning, Western voice, translated place names)"
  },
  {
   "id": "P-NICK",
   "state": "approved",
   "rule": "Quoted nicknames keep the quotes and are translated by meaning when descriptive; the surname is transliterated.",
   "examples": {
    "“Curly” Shaw": "“곱슬머리” 쇼",
    "\"Pig\" Josh": "“돼지” 조시",
    "“The Blade” Slade": "“칼잡이” 슬레이드",
    "“Kid” Cougar": "“꼬마” 쿠거"
   },
   "approved": "2026-11-03 user (AskUserQuestion: nicknames by meaning, Western voice, translated place names)"
  },
  {
   "id": "P-UI",
   "state": "approved",
   "rule": "Menus/HUD/tutorial instructions use concise 해요체-free imperative/noun style (e.g. '사격', '재장전', '~하려면 {BTN}를 누르세요' in tutorials uses 하십시오/하세요체).",
   "approved": "2026-11-03 user (AskUserQuestion: nicknames by meaning, Western voice, translated place names)"
  },
  {
   "id": "P-VOICE",
   "state": "approved",
   "rule": "Dialogue: Old-West tone; strangers/villains speak 반말 or rough 하게체; Red speaks terse 반말; elders to children 반말; townsfolk to Red polite 해요체 unless hostile.",
   "approved": "2026-11-03 user (AskUserQuestion: nicknames by meaning, Western voice, translated place names)"
  },
  {
   "id": "P-PUNCT",
   "state": "approved",
   "rule": "Use only glyph-supported punctuation. '…'(U+2026) and '–'(U+2013) have no glyph in any game font (dropped in the original) -> write '...' and '-'.",
   "approved": "2026-11-03 user (AskUserQuestion: nicknames by meaning, Western voice, translated place names)"
  }
 ],
